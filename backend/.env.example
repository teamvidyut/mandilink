# ---- Nexconn (Console -> your app -> App Key / App Secret / API domain)
# Leave App Key/Secret empty to run in local DEMO MODE (not for submission).
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_API_HOST=https://api.sg-light-api.com
NEXCONN_BACKUP_API_HOST=https://api-b.sg-light-api.com
# Optional: suffix for deal/room channel ids, different per deployment sharing one Nexconn app
CHANNEL_NAMESPACE=

# ---- App
JWT_SECRET=replace-with-a-long-random-string
DATABASE_URL=sqlite:///./mandilink.db
CORS_ORIGINS=http://localhost:5173
SUPPORT_AGENT_PIN=2468

# ---- AI (optional but recommended). gemini | openai | none
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# OpenAI-compatible alternative (OpenAI, Groq, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Live mandi prices (optional): free key from https://data.gov.in
DATAGOV_API_KEY=
